# Copier en .env.local pour surcharger la configuration en local.
#
# VITE_API_BASE_URL
#   Vide en développement (le proxy Vite s'en charge, pas de CORS).
#   URL complète en production, ou vide si front et API partagent le domaine.
#
# VITE_API_PROXY_TARGET
#   Serveur cible du proxy de développement.
#   https://api.eonda.online  → backend distant
#   http://localhost:8080     → backend lancé en local

VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://api.eonda.online
